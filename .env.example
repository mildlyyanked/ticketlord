# Page to watch. revivalhub.com is read through its own listings feed; any other URL is HTML-scraped.
TICKETLORD_URL=https://revivalhub.com/
# Revival Hub regions to watch, comma-separated: Los Angeles, Orange County, Ventura County,
# San Bernardino County, or "all". "Los Angeles" is LA County (incl. Long Beach, Pasadena).
TICKETLORD_REGIONS=Los Angeles
# Nationwide "Wide Release" events (Fathom, Ghibli Fest...): only kept if they match these words.
# Comma-separated, or "all" / "none".
TICKETLORD_WIDE_RELEASE=q&a
# Also include AMC showtimes that Revival Hub merges in (mostly first-run chain screenings)
TICKETLORD_INCLUDE_AMC=0
# Other sites only: set to 1 if the page is rendered by JavaScript (needs: pip install '.[js]' && playwright install chromium)
TICKETLORD_RENDER_JS=0
# Where seen screenings are remembered
TICKETLORD_STATE_FILE=state/seen.json

# Comma-separated words you care about most -> urgent notification.
# Matched against title, director, venue, format (35mm, 70mm...), category (Q&A, Premiere...) and notes.
TICKETLORD_KEYWORDS=kubrick,lynch,70mm,q&a
# 1 = only notify for keyword matches; 0 = notify for every new listing
TICKETLORD_ONLY_KEYWORDS=0
# If more than this many non-keyword screenings appear at once, send one summary instead
TICKETLORD_BATCH_OVER=5

# --- Notification channels (configure one or more) ---
# ntfy.sh: install the ntfy app on your phone and subscribe to this topic. Pick something unguessable.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=

# Pushover
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=

# Telegram (create a bot with @BotFather, get your chat id from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
